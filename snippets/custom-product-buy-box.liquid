{% comment %}
  Renders the PDP purchase panel: a subscription / one-time toggle, an optional subscriber-gift
  callout, an optional value footnote, and the real add-to-cart form. The subscription toggle
  itself is Seal Subscriptions' own auto-injected widget -- Seal detects the standard
  input[name="selling_plan"] field in the add-to-cart form below and relocates it into its own
  DOM to drive it directly, so trying to run a separate custom radio UI in parallel silently
  fights it for control of that field. Instead, product-buy-box.js moves Seal's widget into the
  data-subscription-slot placeholder below (so it renders where the old custom toggle used to),
  reskins it via component-product-buy-box.css, injects the description/compare-price copy Seal's
  own widget has no slot for, keeps the Add to Cart button's price text synced to Seal's live
  selection, and enforces the storefront-side cap of 3 subscription lines in cart / 1 subscription
  per flavor (flavors are separate products) against Seal's own radios by checking /cart.json.

  Accepts:
  - product: {Object} product resource
  - section_id: {String} id of the section that contains this snippet
  - monthly_label / monthly_description / monthly_badge: {String}
  - onetime_label / onetime_description: {String}
  - cta_label: {String}
  - value_link_label: {String} optional, e.g. "Value of one-time purchase"
  - value_link_url: {String} optional
  - subscriber_gift_image / subscriber_gift_image_2: {Object} optional images
  - subscriber_gift_heading: {String} optional
  - subscriber_gift_text: {String} optional, rich text

  Usage:
  {% render 'custom-product-buy-box', product: product, section_id: section.id, ... %}
{% endcomment %}

{{ 'component-product-buy-box.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-buy-box.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign product_form_id = 'product-form-' | append: section_id
  assign variant = product.selected_or_first_available_variant
  assign onetime_price = variant.price | money
-%}

<product-buy-box
  class="product-buy-box"
  data-product-id="{{ product.id }}"
  data-cta-label="{{ cta_label | escape }}"
  data-message-limit-reached="{{ 'products.product.subscription.limit_reached' | t | escape }}"
  data-message-already-subscribed="{{ 'products.product.subscription.already_subscribed' | t | escape }}"
  data-message-already-in-cart="{{ 'products.product.subscription.already_in_cart' | t | escape }}"
  data-monthly-description="{{ monthly_description | escape }}"
  data-onetime-description="{{ onetime_description | escape }}"
  data-onetime-price="{{ onetime_price | escape }}"
  data-per-month-suffix="{{ 'sections.custom_product_info.per_month_suffix' | t | escape }}"
>
  <div class="product-buy-box__subscription-slot" data-subscription-slot></div>
  <p class="product-buy-box__subscription-message" data-subscription-message hidden></p>

  {%- if subscriber_gift_heading != blank -%}
    <div class="product-subscriber-gift">
      <span class="product-subscriber-gift__media">
        {%- if subscriber_gift_image != blank -%}
          {{
            subscriber_gift_image
            | image_url: width: 120
            | image_tag: loading: 'lazy', sizes: '56px', class: 'product-subscriber-gift__icon'
          }}
        {%- else -%}
          <img
            src="{{ 'hat.png' | asset_url }}"
            loading="lazy"
            width="120"
            height="120"
            class="product-subscriber-gift__icon"
            alt=""
          >
        {%- endif -%}
        {%- if subscriber_gift_image_2 != blank -%}
          {{
            subscriber_gift_image_2
            | image_url: width: 120
            | image_tag: loading: 'lazy', sizes: '56px', class: 'product-subscriber-gift__icon'
          }}
        {%- else -%}
          <img
            src="{{ 'towel.png' | asset_url }}"
            loading="lazy"
            width="120"
            height="120"
            class="product-subscriber-gift__icon"
            alt=""
          >
        {%- endif -%}
      </span>
      <div class="product-subscriber-gift__content">
        <p class="product-subscriber-gift__heading">{{ subscriber_gift_heading | escape }}</p>
        {%- if subscriber_gift_text != blank -%}
          <div class="product-subscriber-gift__text rte">{{ subscriber_gift_text }}</div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if value_link_label != blank -%}
    <p class="product-buy-box__value-link">
      {{- value_link_label | escape -}}
    </p>
  {%- endif -%}

  <product-form class="product-buy-box__form" data-section-id="{{ section_id }}">
    <div class="product-form__error-message-wrapper" role="alert" hidden>
      <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
      <span class="product-form__error-message"></span>
    </div>
    {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
      <input
        type="hidden"
        name="id"
        value="{{ product.selected_or_first_available_variant.id }}"
        {% if product.selected_or_first_available_variant == null %}disabled{% endif %}
        class="product-variant-id"
      >
      <input type="hidden" name="selling_plan" value="" data-selling-plan-input>
      <button
        type="submit"
        name="add"
        class="product-buy-box__submit button button--full-width button--primary"
        data-submit-button
        {% if product.selected_or_first_available_variant == null %}disabled{% endif %}
      >
        <span data-cta-label>
          {%- if product.selected_or_first_available_variant == null -%}
            {{ 'products.product.unavailable' | t }}
          {%- else -%}
            {{- cta_label | append: ' - ' | append: onetime_price -}}
          {%- endif -%}
        </span>
        <span class="product-buy-box__submit-arrow svg-wrapper">
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </span>
        {%- render 'loading-spinner' -%}
      </button>
    {%- endform -%}
  </product-form>
</product-buy-box>
