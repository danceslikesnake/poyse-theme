{% comment %}
  Renders the PDP purchase panel: a decorative subscription / one-time toggle, an optional
  subscriber-gift callout, an optional value footnote, and the real add-to-cart form. The toggle
  is presentational only -- no selling plan app is connected yet, so both options add the same
  default variant. When subscriptions are wired up, swap the radio values/data-cta-text below for
  real product.selling_plan_groups entries; the <product-form> add-to-cart mechanics don't need to
  change.

  Accepts:
  - product: {Object} product resource
  - section_id: {String} id of the section that contains this snippet
  - monthly_label / monthly_description / monthly_price / monthly_badge: {String}
  - onetime_label / onetime_price: {String}
  - cta_label: {String}
  - value_link_label: {String} optional, e.g. "Value of one-time purchase"
  - value_link_url: {String} optional
  - subscriber_gift_image / subscriber_gift_image_2: {Object} optional images
  - subscriber_gift_heading: {String} optional
  - subscriber_gift_text: {String} optional, rich text

  Usage:
  {% render 'custom-product-buy-box', product: product, section_id: section.id, ... %}
{% endcomment %}

{{ 'component-product-buy-box.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-buy-box.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign product_form_id = 'product-form-' | append: section_id
  assign is_unavailable = false
  if product.selected_or_first_available_variant == null or product.selected_or_first_available_variant.available == false
    assign is_unavailable = true
  endif
-%}

<product-buy-box class="product-buy-box">
  <fieldset class="product-buy-box__subscription">
    <legend class="visually-hidden">{{ 'sections.custom_product_info.subscription_legend' | t }}</legend>
    <label class="product-buy-box__option">
      <input
        type="radio"
        name="Subscription-{{ product.id }}"
        data-subscription-option
        data-cta-text="{{ cta_label | append: ' - ' | append: monthly_price }}"
        checked
      >
      <span class="product-buy-box__option-indicator" aria-hidden="true"></span>
      <span class="product-buy-box__option-body">
        <span class="product-buy-box__option-head">
          <span class="product-buy-box__option-label">{{ monthly_label | escape }}</span>
          {%- if monthly_badge != blank -%}
            <span class="product-buy-box__option-badge">{{ monthly_badge | escape }}</span>
          {%- endif -%}
        </span>
        {%- if monthly_description != blank -%}
          <span class="product-buy-box__option-description">{{ monthly_description | escape }}</span>
        {%- endif -%}
      </span>
      {%- if monthly_price != blank -%}
        <span class="product-buy-box__option-price">
          <span class="product-buy-box__option-price-current">{{ monthly_price | escape }}</span>
          {%- if onetime_price != blank -%}
            <span class="product-buy-box__option-price-suffix">{{ 'sections.custom_product_info.per_month_suffix' | t }}</span>
            <span class="product-buy-box__option-price-compare">{{ onetime_price | escape }}</span>
          {%- endif -%}
        </span>
      {%- endif -%}
    </label>
    <label class="product-buy-box__option">
      <input
        type="radio"
        name="Subscription-{{ product.id }}"
        data-subscription-option
        data-cta-text="{{ cta_label | append: ' - ' | append: onetime_price }}"
      >
      <span class="product-buy-box__option-indicator" aria-hidden="true"></span>
      <span class="product-buy-box__option-body">
        <span class="product-buy-box__option-head">
          <span class="product-buy-box__option-label">{{ onetime_label | escape }}</span>
        </span>
      </span>
      {%- if onetime_price != blank -%}
        <span class="product-buy-box__option-price">
          <span class="product-buy-box__option-price-current">{{ onetime_price | escape }}</span>
        </span>
      {%- endif -%}
    </label>
  </fieldset>

  {%- if subscriber_gift_heading != blank -%}
    <div class="product-subscriber-gift">
      {%- if subscriber_gift_image != blank or subscriber_gift_image_2 != blank -%}
        <span class="product-subscriber-gift__media">
          {%- if subscriber_gift_image != blank -%}
            {{
              subscriber_gift_image
              | image_url: width: 120
              | image_tag: loading: 'lazy', sizes: '48px', class: 'product-subscriber-gift__icon'
            }}
          {%- endif -%}
          {%- if subscriber_gift_image_2 != blank -%}
            {{
              subscriber_gift_image_2
              | image_url: width: 120
              | image_tag: loading: 'lazy', sizes: '48px', class: 'product-subscriber-gift__icon'
            }}
          {%- endif -%}
        </span>
      {%- endif -%}
      <div class="product-subscriber-gift__content">
        <p class="product-subscriber-gift__heading">{{ subscriber_gift_heading | escape }}</p>
        {%- if subscriber_gift_text != blank -%}
          <div class="product-subscriber-gift__text rte">{{ subscriber_gift_text }}</div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if value_link_label != blank -%}
    <a href="{{ value_link_url | default: '#' }}" class="product-buy-box__value-link">
      {{- value_link_label | escape -}}
    </a>
  {%- endif -%}

  <product-form class="product-buy-box__form" data-section-id="{{ section_id }}">
    <div class="product-form__error-message-wrapper" role="alert" hidden>
      <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
      <span class="product-form__error-message"></span>
    </div>
    {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
      <input
        type="hidden"
        name="id"
        value="{{ product.selected_or_first_available_variant.id }}"
        {% if is_unavailable %}disabled{% endif %}
        class="product-variant-id"
      >
      <button
        type="submit"
        name="add"
        class="product-buy-box__submit button button--full-width button--primary"
        {% if is_unavailable %}disabled{% endif %}
      >
        <span data-cta-label>
          {%- if product.selected_or_first_available_variant == null -%}
            {{ 'products.product.unavailable' | t }}
          {%- elsif is_unavailable -%}
            {{ 'products.product.sold_out' | t }}
          {%- else -%}
            {{- cta_label | append: ' - ' | append: monthly_price -}}
          {%- endif -%}
        </span>
        {%- unless is_unavailable -%}
          <span class="product-buy-box__submit-arrow svg-wrapper">
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </span>
        {%- endunless -%}
        {%- render 'loading-spinner' -%}
      </button>
    {%- endform -%}
  </product-form>
</product-buy-box>
