{%- doc -%}
  Renders the shared nav links + cart icon used by the site header and footer.
  Always uses the 'custom-nav-links' BEM block so both instances share one look.

  @param {object} nav_links - blocks of type 'nav_link'
  @param {number} cart_count - cart.item_count
{%- enddoc -%}

{{ 'component-nav-links.css' | asset_url | stylesheet_tag }}

<nav class="custom-nav-links__nav">
  {%- for block in nav_links -%}
    {%- liquid
      assign is_active = false
      if request.path == block.settings.link
        assign is_active = true
      elsif block.settings.link contains '/collections' and template.name == 'collection'
        assign is_active = true
      elsif block.settings.link contains '/collections' and template.name == 'product'
        assign is_active = true
      endif
    -%}
    <a
      href="{{ block.settings.link }}"
      class="custom-nav-links__nav-link{% if is_active %} is-active{% endif %}"
      {% if is_active %}aria-current="page"{% endif %}
      {{ block.shopify_attributes }}
    >
      {{- block.settings.label | escape -}}
    </a>
  {%- endfor -%}

  <a href="{{ routes.cart_url }}" class="custom-nav-links__cart" data-cart-count data-cart-drawer-toggle>
    <span aria-hidden="true" class="custom-nav-links__cart-count">
      {%- if cart_count < 10 -%}0{{ cart_count }}{%- else -%}{{ cart_count }}{%- endif -%}
    </span>
    {%- comment -%}
      Mobile-only: while the header itself is standing in for the cart drawer's own
      chrome (see .site-header--cart-open in section-custom-site-header.css /
      component-nav-links.css), this replaces the count as the visible close affordance.
      Always rendered (not just on the header instance) since this snippet is shared with
      the footer -- the swap is purely CSS-driven, scoped to .site-header--cart-open, so
      the footer's copy never shows it.
    {%- endcomment -%}
    <span class="custom-nav-links__cart-close svg-wrapper" aria-hidden="true">
      {{- 'icon-close.svg' | inline_asset_content -}}
    </span>
    <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart_count }}</span>
  </a>
</nav>
