{{ 'section-custom-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign nav_links = section.blocks | where: 'type', 'nav_link'
  assign policy_links = section.blocks | where: 'type', 'policy_link'
  assign disclaimer_block = section.blocks | where: 'type', 'disclaimer' | first
  assign cart_count = cart.item_count
  assign current_year = 'now' | date: '%Y'
-%}

{%- style -%}
  .section-{{ section.id }}-border {
    border-color: {{ section.settings.border_color | default: 'rgba(0,0,0,0.12)' }};
  }
{%- endstyle -%}

<footer class="custom-footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-border">
  <div class="custom-footer__inner">
    <div class="custom-footer__top">
      <a href="{{ routes.root_url }}" class="custom-footer__wordmark">
        <img
          src="{{ 'poyse-logo-white.svg' | asset_url }}"
          alt="{{ section.settings.wordmark_text | escape }}"
          class="custom-footer__wordmark-logo"
          width="663"
          height="175"
        >
      </a>

      {%- if nav_links.size > 0 -%}
        {%- render '_nav-links', nav_links: nav_links, cart_count: cart_count -%}
      {%- endif -%}
    </div>


    <div class="custom-footer__bottom">
      <p class="custom-footer__copyright">
        {{- 'sections.custom_footer.copyright' | t: year: current_year, shop: shop.name -}}
      </p>

      {%- if policy_links.size > 0 -%}
        <ul class="custom-footer__policies">
          {%- for block in policy_links -%}
            <li>
              <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
                {{- block.settings.label | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if disclaimer_block != blank and disclaimer_block.settings.text != blank -%}
        <div class="custom-footer__disclaimer rte" {{ disclaimer_block.shopify_attributes }}>
          {{ disclaimer_block.settings.text }}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.custom-footer.name",
  "settings": [
    {
      "type": "text",
      "id": "wordmark_text",
      "default": "POYSE",
      "label": "t:sections.custom-footer.settings.wordmark_text.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:sections.custom-footer.settings.border_color.label"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "t:sections.custom-footer.blocks.nav_link.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "t:sections.custom-footer.blocks.nav_link.settings.label.default",
          "label": "t:sections.custom-footer.blocks.nav_link.settings.label.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.custom-footer.blocks.nav_link.settings.link.label"
        }
      ]
    },
    {
      "type": "policy_link",
      "name": "t:sections.custom-footer.blocks.policy_link.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "t:sections.custom-footer.blocks.policy_link.settings.label.default",
          "label": "t:sections.custom-footer.blocks.policy_link.settings.label.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.custom-footer.blocks.policy_link.settings.link.label"
        }
      ]
    },
    {
      "type": "disclaimer",
      "name": "t:sections.custom-footer.blocks.disclaimer.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "t:sections.custom-footer.blocks.disclaimer.settings.text.default",
          "label": "t:sections.custom-footer.blocks.disclaimer.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-footer.presets.name",
      "blocks": [
        { "type": "nav_link", "settings": { "label": "Shop" } },
        { "type": "nav_link", "settings": { "label": "Science" } },
        { "type": "policy_link", "settings": { "label": "Terms of Service" } },
        { "type": "policy_link", "settings": { "label": "Cookie Preferences" } },
        { "type": "policy_link", "settings": { "label": "Privacy Policy" } },
        { "type": "disclaimer" }
      ]
    }
  ]
}
{% endschema %}
