{{ 'section-custom-email-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_block = section.blocks | where: 'type', 'heading' | first
  assign paragraph_block = section.blocks | where: 'type', 'paragraph' | first
  assign email_form_block = section.blocks | where: 'type', 'email_form' | first
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }}-button {
    background: {{ section.settings.button_background | default: '#D9C9B4' }};
    color: {{ section.settings.button_text_color | default: '#241512' }};
  }
{%- endstyle -%}

<div class="email-footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="email-footer__content page-width">
    {%- if heading_block != blank and heading_block.settings.heading != blank -%}
      <p class="email-footer__heading inline-richtext" {{ heading_block.shopify_attributes }}>
        {{- heading_block.settings.heading -}}
      </p>
    {%- endif -%}

    {%- if paragraph_block != blank and paragraph_block.settings.text != blank -%}
      <div class="email-footer__text rte" {{ paragraph_block.shopify_attributes }}>
        {{ paragraph_block.settings.text }}
      </div>
    {%- endif -%}

    {%- if email_form_block != blank -%}
      <div class="email-footer__form-wrapper" {{ email_form_block.shopify_attributes }}>
        {% form 'customer', class: 'email-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="email-footer__field">
            <label class="visually-hidden" for="EmailFooterForm--{{ section.id }}">
              {{ 'newsletter.label' | t }}
            </label>
            <input
              id="EmailFooterForm--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="email-footer__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="EmailFooterForm-error--{{ section.id }}"
              {% elsif form.posted_successfully? %}
                aria-describedby="EmailFooterForm-success--{{ section.id }}"
              {% endif %}
              placeholder="{{ email_form_block.settings.placeholder_text | escape }}"
              required
            >
            <button
              type="submit"
              class="email-footer__button section-{{ section.id }}-button"
              name="commit"
            >
              {{- email_form_block.settings.button_label | escape -}}
            </button>
          </div>
          {%- if form.errors -%}
            <small class="email-footer__message" id="EmailFooterForm-error--{{ section.id }}">
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </small>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p class="email-footer__message email-footer__message--success" id="EmailFooterForm-success--{{ section.id }}" tabindex="-1" autofocus>
              {{- 'newsletter.success' | t -}}
            </p>
          {%- endif -%}
        {% endform %}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.custom-email-footer.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "t:sections.custom-email-footer.settings.button_background.label"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:sections.custom-email-footer.settings.button_text_color.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.custom-email-footer.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.custom-email-footer.blocks.heading.settings.heading.default",
          "label": "t:sections.custom-email-footer.blocks.heading.settings.heading.label"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "t:sections.custom-email-footer.blocks.paragraph.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "t:sections.custom-email-footer.blocks.paragraph.settings.text.default",
          "label": "t:sections.custom-email-footer.blocks.paragraph.settings.text.label"
        }
      ]
    },
    {
      "type": "email_form",
      "name": "t:sections.custom-email-footer.blocks.email_form.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "placeholder_text",
          "default": "t:sections.custom-email-footer.blocks.email_form.settings.placeholder_text.default",
          "label": "t:sections.custom-email-footer.blocks.email_form.settings.placeholder_text.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "t:sections.custom-email-footer.blocks.email_form.settings.button_label.default",
          "label": "t:sections.custom-email-footer.blocks.email_form.settings.button_label.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-email-footer.presets.name",
      "blocks": [
        { "type": "heading" },
        { "type": "paragraph" },
        { "type": "email_form" }
      ]
    }
  ]
}
{% endschema %}
