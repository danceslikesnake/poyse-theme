{{ 'section-custom-featured-items.css' | asset_url | stylesheet_tag }}
{{ 'section-custom-product-more-flavors.css' | asset_url | stylesheet_tag }}
<script src="{{ 'feature-item.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="more-flavors__header">
      <h2 class="more-flavors__heading inline-richtext">{{ section.settings.heading }}</h2>
      {%- if section.settings.shop_all_label != blank -%}
        <a href="{{ section.settings.shop_all_url | default: routes.all_products_collection_url }}" class="custom-cta-button narrow-padding">
          {{- section.settings.shop_all_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    {%- liquid
      assign flavor_collection = section.settings.flavors_collection
      if flavor_collection == blank
        assign flavor_collection = collections.all
      endif
    -%}
    {%- if flavor_collection != blank -%}
      <div class="featured-items__grid more-flavors__grid">
        {%- for flavor_product in flavor_collection.products -%}
          {%- unless flavor_product.id == product.id -%}
            {%- render 'custom-feature-item',
              product: flavor_product,
              subtitle: flavor_product.metafields.custom.featured_product_subtitle.value,
              hover_image: blank,
              show_new_arrival_badge: flavor_product.metafields.custom.new_arrival.value,
              show_best_seller_badge: flavor_product.metafields.custom.best_seller.value,
              monthly_label: section.settings.monthly_label,
              monthly_price: section.settings.monthly_price,
              onetime_label: section.settings.onetime_label,
              onetime_price: section.settings.onetime_price,
              cta_label: section.settings.cta_label,
              card_color_scheme: section.settings.card_color_scheme,
              unique_key: flavor_product.id
            -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.custom-product-more-flavors.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "t:sections.custom-product-more-flavors.settings.card_color_scheme.label",
      "default": "scheme-2"
    },
    {
      "type": "richtext",
      "id": "heading",
      "default": "t:sections.custom-product-more-flavors.settings.heading.default",
      "label": "t:sections.custom-product-more-flavors.settings.heading.label"
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "default": "t:sections.custom-product-more-flavors.settings.shop_all_label.default",
      "label": "t:sections.custom-product-more-flavors.settings.shop_all_label.label"
    },
    {
      "type": "url",
      "id": "shop_all_url",
      "label": "t:sections.custom-product-more-flavors.settings.shop_all_url.label"
    },
    {
      "type": "header",
      "content": "t:sections.custom-product-more-flavors.settings.header_flavors.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.custom-product-more-flavors.settings.flavors_paragraph.content"
    },
    {
      "type": "collection",
      "id": "flavors_collection",
      "label": "t:sections.custom-product-more-flavors.settings.flavors_collection.label"
    },
    {
      "type": "header",
      "content": "t:sections.custom-product-more-flavors.settings.header_subscription.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.custom-product-more-flavors.settings.subscription_paragraph.content"
    },
    {
      "type": "text",
      "id": "monthly_label",
      "default": "t:sections.custom-product-more-flavors.settings.monthly_label.default",
      "label": "t:sections.custom-product-more-flavors.settings.monthly_label.label"
    },
    {
      "type": "text",
      "id": "monthly_price",
      "default": "t:sections.custom-product-more-flavors.settings.monthly_price.default",
      "label": "t:sections.custom-product-more-flavors.settings.monthly_price.label"
    },
    {
      "type": "text",
      "id": "onetime_label",
      "default": "t:sections.custom-product-more-flavors.settings.onetime_label.default",
      "label": "t:sections.custom-product-more-flavors.settings.onetime_label.label"
    },
    {
      "type": "text",
      "id": "onetime_price",
      "default": "t:sections.custom-product-more-flavors.settings.onetime_price.default",
      "label": "t:sections.custom-product-more-flavors.settings.onetime_price.label"
    },
    {
      "type": "text",
      "id": "cta_label",
      "default": "t:sections.custom-product-more-flavors.settings.cta_label.default",
      "label": "t:sections.custom-product-more-flavors.settings.cta_label.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-product-more-flavors.presets.name"
    }
  ]
}
{% endschema %}
