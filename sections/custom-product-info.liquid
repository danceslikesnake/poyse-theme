{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'section-custom-product-info.css' | asset_url | stylesheet_tag }}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
<script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-flavor-switcher.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.image_zoom == 'hover' -%}
  <script id="EnableZoomOnHover-{{ section.id }}" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign accordion_blocks = section.blocks | where: 'type', 'accordion'
  assign benefits_block = section.blocks | where: 'type', 'benefits_accordion' | first
  assign perk_blocks = section.blocks | where: 'type', 'perk'
  assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
-%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  {%- if section.settings.breadcrumb_label != blank -%}
    <div class="product-breadcrumb-section">
      <nav class="product-breadcrumb" aria-label="{{ 'accessibility.breadcrumbs' | t }}">
        <a href="{{ section.settings.breadcrumb_url | default: routes.all_products_collection_url }}">
          {{- section.settings.breadcrumb_label | escape -}}
        </a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">
          {{- section.settings.heading | escape }} - {{ product.title | escape -}}
        </span>
      </nav>
    </div>
  {%- endif -%}

  <div class="page-width product-info__page-width">
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col{% if product.media.size > 0 %} grid--2-col-tablet{% else %} product--no-media{% endif %} product-info" data-flavor="{{ product.handle }}">
      <div class="grid__item product__media-wrapper{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}">
        {%- render 'product-media-gallery', product: product, variant_images: variant_images, square_media: true -%}
      </div>

      <div class="grid__item product__info-wrapper product-info__details">
        {%- if product.metafields.custom.new_arrival.value or product.metafields.custom.best_seller.value -%}
          <div class="product-badges">
            {%- if product.metafields.custom.new_arrival.value -%}
              <span class="product-badge">{{ 'sections.custom_product_info.badges.new_arrival' | t }}</span>
            {%- endif -%}
            {%- if product.metafields.custom.best_seller.value -%}
              <span class="product-badge">{{ 'sections.custom_product_info.badges.best_seller' | t }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}


        <div>
          <h1 class="product-info__title">{{ section.settings.heading | escape }}</h1>

          {%- if section.settings.subtitle != blank -%}
            <div class="product-info__subtitle inline-richtext">{{ section.settings.subtitle }}</div>
          {%- endif -%}

          {%- if product.metafields.reviews.rating.value != blank -%}
            <div class="rating-wrapper">
              {%- liquid
                assign rating_decimal = 0
                assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
                if decimal >= 0.3 and decimal <= 0.7
                  assign rating_decimal = 0.5
                elsif decimal > 0.7
                  assign rating_decimal = 1
                endif
              -%}
              <div
                      class="rating"
                      role="img"
                      aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
              >
              <span
                      aria-hidden="true"
                      class="rating-star"
                      style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
              ></span>
              </div>
              <p class="rating-summary caption">
                {{-
                'sections.custom_product_info.rating_summary'
                | t: rating: product.metafields.reviews.rating.value, count: product.metafields.reviews.rating_count
                -}}
              </p>
            </div>
          {%- endif -%}

          {%- if product.description != blank -%}
            <div class="product-info__description rte">{{ product.description }}</div>
          {%- endif -%}

          {%- liquid
            assign flavor_collection = section.settings.flavors_collection
            if flavor_collection == blank
              assign flavor_collection = collections.all
            endif
          -%}
          {%- if flavor_collection != blank -%}
            <hr class="product-info__divider">
            <div class="product-flavor-switcher">
              <p class="product-flavor-switcher__label caption-with-letter-spacing">
                {{- section.settings.flavor_label | escape }} &mdash; {{ product.title | escape -}}
              </p>
              <div class="product-flavor-switcher__pills" role="list">
                {%- for flavor_product in flavor_collection.products -%}
                  {%- if flavor_product.id == product.id -%}
                    <span class="product-flavor-switcher__pill is-active" data-flavor="{{ flavor_product.handle }}" aria-current="page">
                    {{- flavor_product.title | escape -}}
                  </span>
                  {%- else -%}
                    <a href="{{ flavor_product.url }}" class="product-flavor-switcher__pill" data-flavor="{{ flavor_product.handle }}">
                      {{- flavor_product.title | escape -}}
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- liquid
                assign flavor_subtitle_metafield = product.metafields.custom.featured_product_subtitle
                if flavor_subtitle_metafield.type == 'rich_text_field'
                  assign flavor_subtitle = flavor_subtitle_metafield | metafield_tag
                elsif flavor_subtitle_metafield.value != blank
                  assign flavor_subtitle = flavor_subtitle_metafield.value
                else
                  assign flavor_subtitle = blank
                endif
              -%}
              {%- if flavor_subtitle != blank -%}
                <p class="product-flavor-switcher__description">{{ flavor_subtitle }}</p>
              {%- endif -%}
            </div>
            <hr class="product-info__divider">
          {%- endif -%}
        </div>

        {%- render 'custom-product-buy-box',
          product: product,
          section_id: section.id,
          monthly_label: section.settings.monthly_label,
          monthly_description: section.settings.monthly_description,
          monthly_badge: section.settings.monthly_badge,
          onetime_label: section.settings.onetime_label,
          onetime_description: section.settings.onetime_description,
          cta_label: section.settings.cta_label,
          value_link_label: section.settings.value_link_label,
          value_link_url: section.settings.value_link_url,
          subscriber_gift_image: section.settings.subscriber_gift_image,
          subscriber_gift_image_2: section.settings.subscriber_gift_image_2,
          subscriber_gift_video: section.settings.subscriber_gift_video,
          subscriber_gift_video_2: section.settings.subscriber_gift_video_2,
          subscriber_gift_heading: section.settings.subscriber_gift_heading,
          subscriber_gift_text: section.settings.subscriber_gift_text
        -%}

        {%- if perk_blocks.size > 0 -%}
          <div class="product-perks-box">
            {%- if section.settings.perks_heading != blank -%}
              <p class="product-perks-box__heading caption-with-letter-spacing">
                {{- section.settings.perks_heading | escape -}}
              </p>
            {%- endif -%}
            <ul class="product-perks list-unstyled">
              {%- for block in perk_blocks -%}
                <li class="product-perks__item" {{ block.shopify_attributes }}>
                  <span class="svg-wrapper">
                    {%- case block.settings.icon -%}
                      {%- when 'truck' -%}
                        {{- 'truck-Icon.svg' | inline_asset_content -}}
                      {%- when 'pause' -%}
                        {{- 'cycle-Icon.svg' | inline_asset_content -}}
                      {%- when 'return' -%}
                        {{- 'undo-Icon.svg' | inline_asset_content -}}
                      {%- else -%}
                        {{- 'icon-checkmark.svg' | inline_asset_content -}}
                    {%- endcase -%}
                  </span>
                  {{- block.settings.text | escape -}}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if accordion_blocks.size > 0 or benefits_block != blank -%}
          {%- for block in accordion_blocks -%}
            <details class="product-static-section" {{ block.shopify_attributes }}>
              <summary class="product-static-section__header" id="ProductAccordionSummary-{{ block.id }}">
                <h3 class="accordion__title inline-richtext h4">{{ block.settings.heading | escape }}</h3>
                <span class="product-static-section__icon">
                  {{- 'plus.svg' | inline_asset_content -}}
                  {{- 'minus.svg' | inline_asset_content -}}
                </span>
              </summary>
              <div class="accordion__content rte" id="ProductAccordionContent-{{ block.id }}">
                {%- if block.settings.content != blank -%}
                  {{ block.settings.content }}
                {%- endif -%}

                {%- if forloop.first -%}
                  {%- if section.settings.supplement_facts_label != blank or section.settings.how_to_use_label != blank -%}
                    <div class="product-info__reveal-triggers">
                      {%- if section.settings.supplement_facts_label != blank -%}
                        {%- assign supplement_facts_modal_id = 'SupplementFactsModal-' | append: section.id -%}
                        {%- render 'product-supplement-facts-modal',
                          product: product,
                          label: section.settings.supplement_facts_label,
                          fallback_image: section.settings.supplement_facts_image,
                          modal_id: supplement_facts_modal_id,
                          button_class: 'product-reveal-btn'
                        -%}
                      {%- endif -%}
                      {%- if section.settings.how_to_use_label != blank -%}
                        <details class="product-reveal">
                          <summary class="product-reveal-btn">
                            {{- section.settings.how_to_use_label | escape -}}
                          </summary>
                          <div class="product-reveal__content rte">
                            {%- if section.settings.how_to_use_content != blank -%}
                              {{ section.settings.how_to_use_content }}
                            {%- else -%}
                              <p>{{ 'sections.custom_product_info.how_to_use_placeholder' | t }}</p>
                            {%- endif -%}
                          </div>
                        </details>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </details>
          {%- endfor -%}

          {%- if benefits_block != blank -%}
            <details class="product-static-section" {{ benefits_block.shopify_attributes }} {% if benefits_block.settings.open_by_default %}open{% endif %}>
              <summary class="product-static-section__header" id="ProductAccordionSummary-{{ benefits_block.id }}">
                <h3 class="accordion__title inline-richtext h4">{{ benefits_block.settings.heading | escape }}</h3>
                <span class="product-static-section__icon">
                  {{- 'plus.svg' | inline_asset_content -}}
                  {{- 'minus.svg' | inline_asset_content -}}
                </span>
              </summary>
              {%- if benefits_block.settings.highlights_content != blank -%}
                <div class="accordion__content" id="ProductAccordionContent-{{ benefits_block.id }}">
                  <div class="product-benefits-highlights rte">{{ benefits_block.settings.highlights_content }}</div>
                </div>
              {%- endif -%}
            </details>
            <ul class="product-benefits list-unstyled">
                {%- if benefits_block.settings.icon_1_label != blank -%}
                  <li class="product-benefits__item">
                        <span class="product-benefits__icon-circle">
                          {%- if benefits_block.settings.icon_1_image != blank -%}
                            {{
                            benefits_block.settings.icon_1_image
                            | image_url: width: 80
                            | image_tag: loading: 'lazy', sizes: '24px', class: 'product-benefits__icon', alt: ''
                            }}
                          {%- else -%}
                            {{- 'leaf-icon.svg' | inline_asset_content -}}
                          {%- endif -%}
                        </span>
                    <span class="product-benefits__label">{{ benefits_block.settings.icon_1_label | escape }}</span>
                  </li>
                {%- endif -%}
                {%- if benefits_block.settings.icon_2_label != blank -%}
                  <li class="product-benefits__item">
                        <span class="product-benefits__icon-circle">
                          {%- if benefits_block.settings.icon_2_image != blank -%}
                            {{
                            benefits_block.settings.icon_2_image
                            | image_url: width: 80
                            | image_tag: loading: 'lazy', sizes: '24px', class: 'product-benefits__icon', alt: ''
                            }}
                          {%- else -%}
                            {{- 'beaker-icon.svg' | inline_asset_content -}}
                          {%- endif -%}
                        </span>
                    <span class="product-benefits__label">{{ benefits_block.settings.icon_2_label | escape }}</span>
                  </li>
                {%- endif -%}
                {%- if benefits_block.settings.icon_3_label != blank -%}
                  <li class="product-benefits__item">
                        <span class="product-benefits__icon-circle">
                          {%- if benefits_block.settings.icon_3_image != blank -%}
                            {{
                            benefits_block.settings.icon_3_image
                            | image_url: width: 80
                            | image_tag: loading: 'lazy', sizes: '24px', class: 'product-benefits__icon', alt: ''
                            }}
                          {%- else -%}
                            {{- 'flag-Icon.svg' | inline_asset_content -}}
                          {%- endif -%}
                        </span>
                    <span class="product-benefits__label">{{ benefits_block.settings.icon_3_label | escape }}</span>
                  </li>
                {%- endif -%}
                {%- if benefits_block.settings.icon_4_label != blank -%}
                  <li class="product-benefits__item">
                        <span class="product-benefits__icon-circle">
                          {%- if benefits_block.settings.icon_4_image != blank -%}
                            {{
                            benefits_block.settings.icon_4_image
                            | image_url: width: 80
                            | image_tag: loading: 'lazy', sizes: '24px', class: 'product-benefits__icon', alt: ''
                            }}
                          {%- else -%}
                            {{- 'wheat-Icon.svg' | inline_asset_content -}}
                          {%- endif -%}
                        </span>
                    <span class="product-benefits__label">{{ benefits_block.settings.icon_4_label | escape }}</span>
                  </li>
                {%- endif -%}
              </ul>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- render 'product-media-modal', variant_images: variant_images -%}
</div>

{% schema %}
{
  "name": "t:sections.custom-product-info.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.custom-product-info.settings.header_media.content"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "default": true,
      "label": "t:sections.custom-product-info.settings.enable_sticky_info.label"
    },
    {
      "type": "select",
      "id": "media_size",
      "options": [
        { "value": "small", "label": "t:sections.custom-product-info.settings.media_size.options__1.label" },
        { "value": "medium", "label": "t:sections.custom-product-info.settings.media_size.options__2.label" },
        { "value": "large", "label": "t:sections.custom-product-info.settings.media_size.options__3.label" }
      ],
      "default": "large",
      "label": "t:sections.custom-product-info.settings.media_size.label"
    },
    {
      "type": "checkbox",
      "id": "constrain_to_viewport",
      "default": true,
      "label": "t:sections.custom-product-info.settings.constrain_to_viewport.label"
    },
    {
      "type": "select",
      "id": "media_fit",
      "options": [
        { "value": "contain", "label": "t:sections.custom-product-info.settings.media_fit.options__1.label" },
        { "value": "cover", "label": "t:sections.custom-product-info.settings.media_fit.options__2.label" }
      ],
      "default": "contain",
      "label": "t:sections.custom-product-info.settings.media_fit.label"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "options": [
        { "value": "stacked", "label": "t:sections.custom-product-info.settings.gallery_layout.options__1.label" },
        { "value": "columns", "label": "t:sections.custom-product-info.settings.gallery_layout.options__2.label" },
        { "value": "thumbnail", "label": "t:sections.custom-product-info.settings.gallery_layout.options__3.label" },
        { "value": "thumbnail_slider", "label": "t:sections.custom-product-info.settings.gallery_layout.options__4.label" }
      ],
      "default": "thumbnail",
      "label": "t:sections.custom-product-info.settings.gallery_layout.label"
    },
    {
      "type": "select",
      "id": "mobile_thumbnails",
      "options": [
        { "value": "columns", "label": "t:sections.custom-product-info.settings.mobile_thumbnails.options__1.label" },
        { "value": "show", "label": "t:sections.custom-product-info.settings.mobile_thumbnails.options__2.label" },
        { "value": "hide", "label": "t:sections.custom-product-info.settings.mobile_thumbnails.options__3.label" }
      ],
      "default": "show",
      "label": "t:sections.custom-product-info.settings.mobile_thumbnails.label"
    },
    {
      "type": "select",
      "id": "image_zoom",
      "options": [
        { "value": "lightbox", "label": "t:sections.custom-product-info.settings.image_zoom.options__1.label" },
        { "value": "hover", "label": "t:sections.custom-product-info.settings.image_zoom.options__2.label" },
        { "value": "none", "label": "t:sections.custom-product-info.settings.image_zoom.options__3.label" }
      ],
      "default": "lightbox",
      "label": "t:sections.custom-product-info.settings.image_zoom.label"
    },
    {
      "type": "checkbox",
      "id": "hide_variants",
      "default": true,
      "label": "t:sections.custom-product-info.settings.hide_variants.label"
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "default": false,
      "label": "t:sections.custom-product-info.settings.enable_video_looping.label"
    },
    {
      "type": "header",
      "content": "t:sections.custom-product-info.settings.header_content.content"
    },
    {
      "type": "text",
      "id": "breadcrumb_label",
      "default": "t:sections.custom-product-info.settings.breadcrumb_label.default",
      "label": "t:sections.custom-product-info.settings.breadcrumb_label.label"
    },
    {
      "type": "url",
      "id": "breadcrumb_url",
      "label": "t:sections.custom-product-info.settings.breadcrumb_url.label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "t:sections.custom-product-info.settings.heading.default",
      "label": "t:sections.custom-product-info.settings.heading.label"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "default": "t:sections.custom-product-info.settings.subtitle.default",
      "label": "t:sections.custom-product-info.settings.subtitle.label"
    },
    {
      "type": "header",
      "content": "t:sections.custom-product-info.settings.header_flavors.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.custom-product-info.settings.flavors_paragraph.content"
    },
    {
      "type": "collection",
      "id": "flavors_collection",
      "label": "t:sections.custom-product-info.settings.flavors_collection.label"
    },
    {
      "type": "text",
      "id": "flavor_label",
      "default": "t:sections.custom-product-info.settings.flavor_label.default",
      "label": "t:sections.custom-product-info.settings.flavor_label.label"
    },
    {
      "type": "header",
      "content": "t:sections.custom-product-info.settings.header_subscription.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.custom-product-info.settings.subscription_paragraph.content"
    },
    {
      "type": "text",
      "id": "monthly_label",
      "default": "t:sections.custom-product-info.settings.monthly_label.default",
      "label": "t:sections.custom-product-info.settings.monthly_label.label"
    },
    {
      "type": "text",
      "id": "monthly_description",
      "default": "t:sections.custom-product-info.settings.monthly_description.default",
      "label": "t:sections.custom-product-info.settings.monthly_description.label"
    },
    {
      "type": "text",
      "id": "monthly_badge",
      "default": "t:sections.custom-product-info.settings.monthly_badge.default",
      "label": "t:sections.custom-product-info.settings.monthly_badge.label"
    },
    {
      "type": "text",
      "id": "onetime_label",
      "default": "t:sections.custom-product-info.settings.onetime_label.default",
      "label": "t:sections.custom-product-info.settings.onetime_label.label"
    },
    {
      "type": "text",
      "id": "onetime_description",
      "default": "t:sections.custom-product-info.settings.onetime_description.default",
      "label": "t:sections.custom-product-info.settings.onetime_description.label"
    },
    {
      "type": "text",
      "id": "cta_label",
      "default": "t:sections.custom-product-info.settings.cta_label.default",
      "label": "t:sections.custom-product-info.settings.cta_label.label"
    },
    {
      "type": "text",
      "id": "value_link_label",
      "default": "t:sections.custom-product-info.settings.value_link_label.default",
      "label": "t:sections.custom-product-info.settings.value_link_label.label"
    },
    {
      "type": "url",
      "id": "value_link_url",
      "label": "t:sections.custom-product-info.settings.value_link_url.label"
    },
    {
      "type": "header",
      "content": "t:sections.custom-product-info.settings.header_gift.content"
    },
    {
      "type": "image_picker",
      "id": "subscriber_gift_image",
      "label": "t:sections.custom-product-info.settings.subscriber_gift_image.label"
    },
    {
      "type": "video",
      "id": "subscriber_gift_video",
      "label": "t:sections.custom-product-info.settings.subscriber_gift_video.label",
      "info": "t:sections.custom-product-info.settings.subscriber_gift_video.info"
    },
    {
      "type": "image_picker",
      "id": "subscriber_gift_image_2",
      "label": "t:sections.custom-product-info.settings.subscriber_gift_image_2.label"
    },
    {
      "type": "video",
      "id": "subscriber_gift_video_2",
      "label": "t:sections.custom-product-info.settings.subscriber_gift_video_2.label",
      "info": "t:sections.custom-product-info.settings.subscriber_gift_video_2.info"
    },
    {
      "type": "text",
      "id": "subscriber_gift_heading",
      "default": "t:sections.custom-product-info.settings.subscriber_gift_heading.default",
      "label": "t:sections.custom-product-info.settings.subscriber_gift_heading.label"
    },
