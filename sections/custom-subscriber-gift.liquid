{{ 'section-custom-subscriber-gift.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign media_block = section.blocks | where: 'type', 'media' | first
  assign content_block = section.blocks | where: 'type', 'content' | first
  assign gift_item_blocks = section.blocks | where: 'type', 'gift_item'
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="subscriber-gift color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding page-width">
  <div class="subscriber-gift__grid">
    {%- if media_block != blank -%}
      <div class="subscriber-gift__media" {{ media_block.shopify_attributes }}>
        {%- if media_block.settings.image != blank -%}
          {{
            media_block.settings.image
            | image_url: width: 1200
            | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 50vw, 100vw', class: 'subscriber-gift__image'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="subscriber-gift__content color-{{ section.settings.card_color_scheme }}">
      {%- if content_block != blank -%}
        <div {{ content_block.shopify_attributes }}>
          {%- if content_block.settings.heading != blank -%}
            <h2 class="subscriber-gift__heading">{{ content_block.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if content_block.settings.text != blank -%}
            <div class="subscriber-gift__text rte">{{ content_block.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if gift_item_blocks.size > 0 -%}
        <ul class="subscriber-gift__items list-unstyled">
          {%- for block in gift_item_blocks -%}
            <li class="subscriber-gift__item" {{ block.shopify_attributes }}>
              <div class="subscriber-gift__item-media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 200
                    | image_tag: loading: 'lazy', sizes: '80px', class: 'subscriber-gift__item-image'
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="subscriber-gift__item-info">
                {%- if block.settings.title != blank -%}
                  <p class="subscriber-gift__item-title">{{ block.settings.title | escape }}</p>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="subscriber-gift__item-description">{{ block.settings.description | escape }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.custom-subscriber-gift.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "t:sections.custom-subscriber-gift.settings.card_color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "t:sections.custom-subscriber-gift.blocks.media.name",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.custom-subscriber-gift.blocks.media.settings.image.label"
        }
      ]
    },
    {
      "type": "content",
      "name": "t:sections.custom-subscriber-gift.blocks.content.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "t:sections.custom-subscriber-gift.blocks.content.settings.heading.default",
          "label": "t:sections.custom-subscriber-gift.blocks.content.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "t:sections.custom-subscriber-gift.blocks.content.settings.text.default",
          "label": "t:sections.custom-subscriber-gift.blocks.content.settings.text.label"
        }
      ]
    },
    {
      "type": "gift_item",
      "name": "t:sections.custom-subscriber-gift.blocks.gift_item.name",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.custom-subscriber-gift.blocks.gift_item.settings.image.label"
        },
        {
          "type": "text",
          "id": "title",
          "default": "t:sections.custom-subscriber-gift.blocks.gift_item.settings.title.default",
          "label": "t:sections.custom-subscriber-gift.blocks.gift_item.settings.title.label"
        },
        {
          "type": "text",
          "id": "description",
          "default": "t:sections.custom-subscriber-gift.blocks.gift_item.settings.description.default",
          "label": "t:sections.custom-subscriber-gift.blocks.gift_item.settings.description.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-subscriber-gift.presets.name",
      "blocks": [
        { "type": "media" },
        { "type": "content" },
        { "type": "gift_item" },
        { "type": "gift_item" },
        { "type": "gift_item" }
      ]
    }
  ]
}
{% endschema %}
