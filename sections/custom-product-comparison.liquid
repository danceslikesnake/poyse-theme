{{ 'section-custom-product-comparison.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign rows = section.blocks | where: 'type', 'row'
-%}

<div class="color-{{ section.settings.color_scheme }} custom-comparison section-{{ section.id }}-padding">
  <div class="custom-page-width comparison">
    <div class="comparison__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="comparison__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="comparison__heading">{{ section.settings.heading | escape }}</h2>
    </div>

    {%- if rows.size > 0 -%}
      <div class="comparison__table-wrapper">
        <table class="comparison__table">
          <thead>
            <tr>
              <th scope="col" class="comparison__row-label"></th>
              <th scope="col" class="comparison__col comparison__col--featured">
                {{- section.settings.poyse_column_label | escape -}}
              </th>
              <th scope="col" class="comparison__col">{{ section.settings.traditional_column_label | escape }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in rows -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row" class="comparison__row-label">{{ block.settings.label | escape }}</th>
                <td class="comparison__col comparison__col--featured">
                  <span class="comparison__cell">
                    {%- if block.settings.poyse_check -%}
                      <span class="svg-wrapper comparison__check">{{- 'check-circle-icon.svg' | inline_asset_content -}}</span>
                    {%- endif -%}
                    <span class="comparison__cell-text">{{- block.settings.poyse_value | escape -}}</span>
                  </span>
                </td>
                <td class="comparison__col">
                  <span class="comparison__cell">
                    <span class="svg-wrapper comparison__check comparison__check--times">{{- 'check-times-icon.svg' | inline_asset_content -}}</span>
                    <span class="comparison__cell-text">{{- block.settings.traditional_value | escape -}}</span>
                  </span>
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.custom-product-comparison.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "t:sections.custom-product-comparison.settings.eyebrow.default",
      "label": "t:sections.custom-product-comparison.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "t:sections.custom-product-comparison.settings.heading.default",
      "label": "t:sections.custom-product-comparison.settings.heading.label"
    },
    {
      "type": "text",
      "id": "poyse_column_label",
      "default": "t:sections.custom-product-comparison.settings.poyse_column_label.default",
      "label": "t:sections.custom-product-comparison.settings.poyse_column_label.label"
    },
    {
      "type": "text",
      "id": "traditional_column_label",
      "default": "t:sections.custom-product-comparison.settings.traditional_column_label.default",
      "label": "t:sections.custom-product-comparison.settings.traditional_column_label.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.custom-product-comparison.blocks.row.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "t:sections.custom-product-comparison.blocks.row.settings.label.default",
          "label": "t:sections.custom-product-comparison.blocks.row.settings.label.label"
        },
        {
          "type": "checkbox",
          "id": "poyse_check",
          "default": true,
          "label": "t:sections.custom-product-comparison.blocks.row.settings.poyse_check.label"
        },
        {
          "type": "text",
          "id": "poyse_value",
          "default": "t:sections.custom-product-comparison.blocks.row.settings.poyse_value.default",
          "label": "t:sections.custom-product-comparison.blocks.row.settings.poyse_value.label"
        },
        {
          "type": "text",
          "id": "traditional_value",
          "default": "t:sections.custom-product-comparison.blocks.row.settings.traditional_value.default",
          "label": "t:sections.custom-product-comparison.blocks.row.settings.traditional_value.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-product-comparison.presets.name",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
