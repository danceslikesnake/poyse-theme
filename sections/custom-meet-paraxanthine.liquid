{{ 'section-custom-meet-paraxanthine.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign content_block = section.blocks | where: 'type', 'content' | first
  assign button_block = section.blocks | where: 'type', 'button' | first
-%}

{%- style -%}
  .section-{{ section.id }}-border {
    border-color: {{ section.settings.border_color | default: 'rgba(0,0,0,0.12)' }};
  }
{%- endstyle -%}

<div class="meet-paraxanthine section-{{ section.id }}-border">
  <div class="meet-paraxanthine__media">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          image_size: '1800x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          class: 'meet-paraxanthine__image'
      }}
    {%- elsif section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag:
          loading: 'lazy',
          widths: '750, 1100, 1500, 1800',
          sizes: '100vw',
          class: 'meet-paraxanthine__image'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg meet-paraxanthine__image' }}
    {%- endif -%}
  </div>

  {%- if button_block != blank and button_block.settings.label != blank -%}
    <a
      {% if button_block.settings.link == blank %}
        role="link" aria-disabled="true"
      {% else %}
        href="{{ button_block.settings.link }}"
      {% endif %}
      class="meet-paraxanthine__button custom-cta-button tan"
      {{ button_block.shopify_attributes }}
    >
      {{- button_block.settings.label | escape -}}
    </a>
  {%- endif -%}

  {%- if content_block != blank -%}
    <div class="meet-paraxanthine__card">
      <div class="meet-paraxanthine__content" {{ content_block.shopify_attributes }}>
        {%- if content_block.settings.heading != blank -%}
          <p class="meet-paraxanthine__heading inline-richtext">{{ content_block.settings.heading }}</p>
        {%- endif -%}
        {%- if content_block.settings.text != blank -%}
          <div class="meet-paraxanthine__text rte">{{ content_block.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.custom-meet-paraxanthine.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.custom-meet-paraxanthine.settings.image.label"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.custom-meet-paraxanthine.settings.video.label",
      "info": "t:sections.custom-meet-paraxanthine.settings.video.info"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:sections.custom-meet-paraxanthine.settings.border_color.label"
    }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "t:sections.custom-meet-paraxanthine.blocks.content.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.custom-meet-paraxanthine.blocks.content.settings.heading.default",
          "label": "t:sections.custom-meet-paraxanthine.blocks.content.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "t:sections.custom-meet-paraxanthine.blocks.content.settings.text.default",
          "label": "t:sections.custom-meet-paraxanthine.blocks.content.settings.text.label"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.custom-meet-paraxanthine.blocks.button.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "t:sections.custom-meet-paraxanthine.blocks.button.settings.label.default",
          "label": "t:sections.custom-meet-paraxanthine.blocks.button.settings.label.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.custom-meet-paraxanthine.blocks.button.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-meet-paraxanthine.presets.name",
      "blocks": [
        { "type": "content" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
