{{ 'section-custom-product-faq.css' | asset_url | stylesheet_tag }}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign questions = section.blocks | where: 'type', 'question'
-%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="product-faq__header">
      <h2 class="product-faq__heading inline-richtext">{{ section.settings.heading }}</h2>
      {%- if section.settings.deeper_dive_label != blank -%}
        <a href="{{ section.settings.deeper_dive_url | default: '#' }}" class="custom-cta-button narrow-padding">
          {{- section.settings.deeper_dive_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    {%- if questions.size > 0 -%}
      <div class="product-faq__columns">
        {%- for block in questions -%}
          <div class="accordion product-faq__item" {{ block.shopify_attributes }}>
            <details id="ProductFaq-{{ block.id }}" {% if block.settings.open_by_default %}open{% endif %}>
              <summary id="ProductFaqSummary-{{ block.id }}">
                <h3 class="accordion__title inline-richtext h4">{{ block.settings.question | escape }}</h3>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <div class="accordion__content rte" id="ProductFaqContent-{{ block.id }}" role="region">
                {{ block.settings.answer }}
              </div>
            </details>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.custom-product-faq.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "richtext",
      "id": "heading",
      "default": "t:sections.custom-product-faq.settings.heading.default",
      "label": "t:sections.custom-product-faq.settings.heading.label"
    },
    {
      "type": "text",
      "id": "deeper_dive_label",
      "default": "t:sections.custom-product-faq.settings.deeper_dive_label.default",
      "label": "t:sections.custom-product-faq.settings.deeper_dive_label.label"
    },
    {
      "type": "url",
      "id": "deeper_dive_url",
      "label": "t:sections.custom-product-faq.settings.deeper_dive_url.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.custom-product-faq.blocks.question.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "default": "t:sections.custom-product-faq.blocks.question.settings.question.default",
          "label": "t:sections.custom-product-faq.blocks.question.settings.question.label"
        },
        {
          "type": "richtext",
          "id": "answer",
          "default": "t:sections.custom-product-faq.blocks.question.settings.answer.default",
          "label": "t:sections.custom-product-faq.blocks.question.settings.answer.label"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "default": false,
          "label": "t:sections.custom-product-faq.blocks.question.settings.open_by_default.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-product-faq.presets.name",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
