{{ 'section-custom-product-faq.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign questions = section.blocks | where: 'type', 'question'
-%}

<div class="color-{{ section.settings.color_scheme }} custom-faq section-{{ section.id }}-padding">
  <div class="product-faq__header">
    <h2 class="product-faq__heading inline-richtext">{{ section.settings.heading }}</h2>
    {%- if section.settings.deeper_dive_label != blank -%}
      <a href="{{ section.settings.deeper_dive_url | default: '#' }}" class="custom-cta-button narrow-padding">
        {{- section.settings.deeper_dive_label | escape -}}
      </a>
    {%- endif -%}
  </div>
  <div class="custom-page-width">
    {%- if questions.size > 0 -%}
      <div class="product-faq__columns">
        <div class="product-faq__column">
          {%- for block in questions -%}
            {%- if block.settings.column == 'right' -%}
              {%- continue -%}
            {%- endif -%}
            <div class="product-faq__card" {{ block.shopify_attributes }}>
              <details id="ProductFaq-{{ block.id }}" {% if block.settings.open_by_default %}open{% endif %}>
                <summary id="ProductFaqSummary-{{ block.id }}" class="product-faq__summary">
                  <h3 class="product-faq__question inline-richtext">{{ block.settings.question | escape }}</h3>
                  <span class="product-faq__toggle" aria-hidden="true"></span>
                </summary>
                <div class="product-faq__answer rte" id="ProductFaqContent-{{ block.id }}" role="region">
                  {{ block.settings.answer }}
                </div>
              </details>
            </div>
          {%- endfor -%}
        </div>
        <div class="product-faq__column">
          {%- for block in questions -%}
            {%- unless block.settings.column == 'right' -%}
              {%- continue -%}
            {%- endunless -%}
            <div class="product-faq__card" {{ block.shopify_attributes }}>
              <details id="ProductFaq-{{ block.id }}" {% if block.settings.open_by_default %}open{% endif %}>
                <summary id="ProductFaqSummary-{{ block.id }}" class="product-faq__summary">
                  <h3 class="product-faq__question inline-richtext">{{ block.settings.question | escape }}</h3>
                  <span class="product-faq__toggle" aria-hidden="true"></span>
                </summary>
                <div class="product-faq__answer rte" id="ProductFaqContent-{{ block.id }}" role="region">
                  {{ block.settings.answer }}
                </div>
              </details>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.custom-product-faq.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "richtext",
      "id": "heading",
      "default": "t:sections.custom-product-faq.settings.heading.default",
      "label": "t:sections.custom-product-faq.settings.heading.label"
    },
    {
      "type": "text",
      "id": "deeper_dive_label",
      "default": "t:sections.custom-product-faq.settings.deeper_dive_label.default",
      "label": "t:sections.custom-product-faq.settings.deeper_dive_label.label"
    },
    {
      "type": "url",
      "id": "deeper_dive_url",
      "label": "t:sections.custom-product-faq.settings.deeper_dive_url.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.custom-product-faq.blocks.question.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "default": "t:sections.custom-product-faq.blocks.question.settings.question.default",
          "label": "t:sections.custom-product-faq.blocks.question.settings.question.label"
        },
        {
          "type": "richtext",
          "id": "answer",
          "default": "t:sections.custom-product-faq.blocks.question.settings.answer.default",
          "label": "t:sections.custom-product-faq.blocks.question.settings.answer.label"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "default": false,
          "label": "t:sections.custom-product-faq.blocks.question.settings.open_by_default.label"
        },
        {
          "type": "select",
          "id": "column",
          "options": [
            {
              "value": "left",
              "label": "t:sections.custom-product-faq.blocks.question.settings.column.options__1.label"
            },
            {
              "value": "right",
              "label": "t:sections.custom-product-faq.blocks.question.settings.column.options__2.label"
            }
          ],
          "default": "left",
          "label": "t:sections.custom-product-faq.blocks.question.settings.column.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-product-faq.presets.name",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
