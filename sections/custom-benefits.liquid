{{ 'section-custom-benefits.css' | asset_url | stylesheet_tag }}
<script src="{{ 'benefits-progress.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'lottie-light.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'benefits-lottie.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign content_block = section.blocks | where: 'type', 'content' | first
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
-%}

{%- comment -%}
  The Lottie file has exactly 11 baked photo slots (asset ids 0-10), one per
  merchant-editable setting below - order and count are fixed by the
  animation itself, not a repeatable block list. Built as a pipe-delimited
  string and split into an array since Shopify Liquid has no array-push.
{%- endcomment -%}
{%- capture photo_url_pipe_list -%}
  {%- for i in (1..11) -%}
    {%- assign setting_key = 'lottie_photo_' | append: i -%}
    {%- assign photo_image = section.settings[setting_key] -%}
    {%- if photo_image != blank -%}
      {%- assign photo_url = photo_image | image_url: width: 700 -%}
    {%- else -%}
      {%- assign fallback_index = i | minus: 1 -%}
      {%- assign fallback_file = 'image_' | append: fallback_index | append: '.png' -%}
      {%- assign photo_url = fallback_file | asset_url -%}
    {%- endif -%}
    {{- photo_url -}}
    {%- unless forloop.last -%}|{%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign photo_url_list = photo_url_pipe_list | split: '|' -%}

{%- comment -%}
  Mobile-only placeholder for the Lottie's motion until a horizontal
  version exists: same 11 photos, cascading right to left one at a time
  (grow in, hold, shrink-and-fade out past the left edge). Directly ports
  the timing shape of this theme's original benefits-stack effect - cards
  start a fixed, short gap apart (not 1/N of the total timeline), so with a
  much longer per-card rise, several cards are mid-rise at once, fanned out
  overlapping rather than a one-at-a-time handoff.
{%- endcomment -%}
{%- liquid
  assign filmstrip_stagger = 0.6
  assign filmstrip_card_duration = 4.5
  assign filmstrip_last_index = photo_url_list.size | minus: 1
  assign filmstrip_last_start = filmstrip_last_index | times: filmstrip_stagger
  assign filmstrip_duration = filmstrip_last_start | plus: filmstrip_card_duration | round: 2
-%}
{%- style -%}
  {%- for photo_url in photo_url_list -%}
    {%- assign filmstrip_start_time = forloop.index0 | times: filmstrip_stagger -%}
    {%- assign filmstrip_start_pct = filmstrip_start_time | times: 100.0 | divided_by: filmstrip_duration -%}
    {%- assign filmstrip_card_pct = filmstrip_card_duration | times: 100.0 | divided_by: filmstrip_duration -%}
    {%- assign filmstrip_rise_pct = filmstrip_card_pct | times: 0.55 -%}
    {%- assign filmstrip_hold_pct = filmstrip_card_pct | times: 0.6 -%}
    {%- assign filmstrip_vanish_pct = filmstrip_card_pct | times: 0.61 -%}
    {%- assign filmstrip_rise_end = filmstrip_start_pct | plus: filmstrip_rise_pct | round: 2 -%}
    {%- assign filmstrip_hold_end = filmstrip_start_pct | plus: filmstrip_hold_pct | round: 2 -%}
    {%- assign filmstrip_vanish_end = filmstrip_start_pct | plus: filmstrip_vanish_pct | round: 2 -%}
    {%- assign filmstrip_start_pct = filmstrip_start_pct | round: 2 -%}
    @keyframes benefits-filmstrip-cascade-{{ section.id }}-{{ forloop.index0 }} {
      0% {
        transform: translateX(100%) scale(0.45);
        opacity: 0;
        z-index: 1;
      }
      {{ filmstrip_start_pct }}% {
        transform: translateX(100%) scale(0.45);
        opacity: 0;
        z-index: 1;
      }
      {{ filmstrip_rise_end }}% {
        transform: translateX(0) scale(1);
        opacity: 1;
        z-index: 10;
      }
      {{ filmstrip_hold_end }}% {
        transform: translateX(0) scale(1);
        opacity: 1;
        z-index: 10;
      }
      {{ filmstrip_vanish_end }}%,
      100% {
        transform: translateX(-100%) scale(1.05);
        opacity: 0;
        z-index: 1;
      }
    }
  {%- endfor -%}
{%- endstyle -%}

<benefits-progress class="benefits color-{{ section.settings.color_scheme }} gradient">
  <div class="benefits__grid" data-benefits-grid>
    <div class="benefits__left" data-benefits-left>
      {%- if content_block != blank and content_block.settings.heading != blank -%}
        <p class="benefits__heading inline-richtext" {{ content_block.shopify_attributes }}>
          {{- content_block.settings.heading -}}
        </p>
      {%- endif -%}

      <div class="benefits__body">
        <div class="benefits__progress" data-benefits-progress hidden>
          <div class="benefits__progress-track" data-benefits-progress-track>
            <div class="benefits__progress-thumb" data-benefits-progress-thumb>&#8203;</div>
          </div>
        </div>

        <benefits-lottie data-animation-url="{{ 'benefits-lottie.json' | asset_url }}">
          {%- comment -%}
            Desktop (>=1024px): plays the Lottie's authored crossfade in
            place. The poster is a plain <img> fallback shown until the
            player attaches (also covers reduced-motion / JS-disabled).
          {%- endcomment -%}
          <div class="benefits__lottie" aria-hidden="true">
            <img
              src="{{ photo_url_list.first }}"
              loading="lazy"
              width="700"
              height="700"
              alt=""
              class="benefits__lottie-poster"
              data-lottie-poster
            >
            <div class="benefits__lottie-canvas" data-lottie-target></div>
            <script type="application/json" data-lottie-overrides>{{ photo_url_list | json }}</script>
          </div>

          {%- comment -%}
            Mobile (<1024px) placeholder: the Lottie has no native left/right
            travel to redirect, so until a horizontal version exists, the
            same 11 photos cascade right to left one at a time via the
            keyframes generated above.
          {%- endcomment -%}
          <div class="benefits__filmstrip" aria-hidden="true">
            <div class="benefits__filmstrip-track" style="--filmstrip-duration: {{ filmstrip_duration }}s;">
              {%- for photo_url in photo_url_list -%}
                <div
                  class="benefits__filmstrip-item"
                  style="animation-name: benefits-filmstrip-cascade-{{ section.id }}-{{ forloop.index0 }};"
                >
                  <img
                    src="{{ photo_url }}"
                    loading="lazy"
                    width="320"
                    height="320"
                    alt=""
                    class="benefits__filmstrip-image"
                  >
                </div>
              {%- endfor -%}
            </div>
          </div>
        </benefits-lottie>
      </div>
    </div>

    {%- if benefit_blocks.size > 0 -%}
      <div class="benefits__right">
        {%- for block in benefit_blocks -%}
          <div class="benefits__card" {{ block.shopify_attributes }}>
            <div class="benefits__card-top">
              {%- if block.settings.eyebrow != blank -%}
                <span class="benefits__card-eyebrow">{{ block.settings.eyebrow | escape }}</span>
              {%- endif -%}
              {%- if block.settings.meta != blank -%}
                <span class="benefits__card-meta">{{ block.settings.meta | escape }}</span>
              {%- endif -%}
            </div>
            {%- if block.settings.heading != blank -%}
              <p class="benefits__card-heading">{{ block.settings.heading | escape }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="benefits__card-text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</benefits-progress>

