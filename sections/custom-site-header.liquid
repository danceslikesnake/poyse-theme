{{ 'section-custom-site-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'site-header.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign nav_links = section.blocks | where: 'type', 'nav_link'
  assign cart_count = cart.item_count
-%}

<site-header
  class="site-header {% if template.name == 'index' %} site-header--animated{% endif %}"
>
  <div class="site-header__inner">
    <a href="{{ routes.root_url }}" class="site-header__wordmark">
      <img
        src="{{ 'poyse-logo-white.svg' | asset_url }}"
        alt="{{ section.settings.wordmark_text | escape }}"
        class="site-header__wordmark-logo site-header__wordmark-logo--white"
        width="663"
        height="175"
      >
      <img
        src="{{ 'poyse-logo-black.svg' | asset_url }}"
        alt=""
        aria-hidden="true"
        class="site-header__wordmark-logo site-header__wordmark-logo--black"
        width="663"
        height="175"
      >
    </a>

    {%- render '_nav-links', nav_links: nav_links, cart_count: cart_count -%}
  </div>
</site-header>

{% schema %}
{
  "name": "t:sections.custom-site-header.name",
  "settings": [
    {
      "type": "text",
      "id": "wordmark_text",
      "default": "POYSE",
      "label": "t:sections.custom-site-header.settings.wordmark_text.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "t:sections.custom-site-header.blocks.nav_link.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "t:sections.custom-site-header.blocks.nav_link.settings.label.default",
          "label": "t:sections.custom-site-header.blocks.nav_link.settings.label.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.custom-site-header.blocks.nav_link.settings.link.label"
        }
      ]
    }
  ]
}
{% endschema %}
