{{ 'section-custom-site-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'site-header.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign nav_links = section.blocks | where: 'type', 'nav_link'
  assign cart_count = cart.item_count
-%}

<site-header
  class="site-header {% if template.name == 'index' %} site-header--animated{% endif %}"
>
  <div class="site-header__inner">
    <a href="{{ routes.root_url }}" class="site-header__wordmark">
      {{- section.settings.wordmark_text | escape -}}
    </a>

    <nav class="site-header__nav">
      {%- for block in nav_links -%}
        {%- liquid
          assign is_active = false
          if request.path == block.settings.link
            assign is_active = true
          elsif block.settings.link contains '/collections' and template.name == 'collection'
            assign is_active = true
          elsif block.settings.link contains '/collections' and template.name == 'product'
            assign is_active = true
          endif
        -%}
        <a
          href="{{ block.settings.link }}"
          class="site-header__nav-link{% if is_active %} is-active{% endif %}"
          {% if is_active %}aria-current="page"{% endif %}
          {{ block.shopify_attributes }}
        >
          {{- block.settings.label | escape -}}
        </a>
      {%- endfor -%}

      <a href="{{ routes.cart_url }}" class="site-header__cart" data-cart-count>
        <span aria-hidden="true">{% if cart_count < 10 %}0{{ cart_count }}{% else %}{{ cart_count }}{% endif %}</span>
        <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart_count }}</span>
      </a>
    </nav>
  </div>
</site-header>

{% schema %}
{
  "name": "t:sections.custom-site-header.name",
  "settings": [
    {
      "type": "text",
      "id": "wordmark_text",
      "default": "POYSE",
      "label": "t:sections.custom-site-header.settings.wordmark_text.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "t:sections.custom-site-header.blocks.nav_link.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "t:sections.custom-site-header.blocks.nav_link.settings.label.default",
          "label": "t:sections.custom-site-header.blocks.nav_link.settings.label.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.custom-site-header.blocks.nav_link.settings.link.label"
        }
      ]
    }
  ]
}
{% endschema %}
