{{ 'section-custom-site-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'site-header.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign nav_links = section.blocks | where: 'type', 'nav_link'
  assign cart_count = cart.item_count

  assign is_shrink = false
  assign is_color_shift = false
  assign color_zones = blank
  assign initial_color = blank
  if template.name == 'index'
    assign is_shrink = true
    assign is_color_shift = true
    # Ordered top-to-bottom; each zone's color applies once its selector has
    # fully scrolled past. Featured Items (black) > Meet Paraxanthine +
    # Benefits (white) > Community (black) > email footer (white).
    assign color_zones = '[{"selector":".tagline-banner","color":"black"},{"selector":".featured-items__outer","color":"white"},{"selector":".benefits","color":"black"},{"selector":".community-gallery","color":"white"}]'
  elsif template.suffix == 'science'
    assign is_color_shift = true
    # Ordered top-to-bottom; each zone's color applies once its selector has
    # fully scrolled past. Formula (black) > Our Hero Ingredient (white) >
    # Ingredients + Featured Items (black) > email footer (white).
    assign color_zones = '[{"selector":".science-hero","color":"black"},{"selector":".science-formula","color":"white"},{"selector":".science-paraxanthine","color":"black"},{"selector":".featured-items__outer","color":"white"}]'
  elsif template.name == 'collection' and template.suffix == 'products'
    assign is_color_shift = true
    # Unlike index/science, this template has no hero under the header, so it
    # must start black (the shared default) instead of the color-shift JS's
    # white fallback; white once the Premium Subscriber Gift section is reached.
    assign initial_color = 'black'
    assign color_zones = '[{"selector":".featured-items__outer","color":"white"}]'
  elsif template.name == 'product' and template.suffix == 'custom'
    assign is_color_shift = true
    # No hero under the header here either, so start black like the shop page.
    # Our Ingredients and Comparison have stable classes but the buy-box
    # section above them doesn't, so these zones trigger on entering
    # (edge: top) rather than on fully leaving the previous section.
    assign initial_color = 'black'
    assign color_zones = '[{"selector":".custom-ingredients","color":"white","edge":"top"},{"selector":".custom-faq","color":"black","edge":"top"}]'
  endif
-%}

<site-header
  class="site-header{% if is_shrink %} site-header--shrink{% endif %}{% if is_color_shift %} site-header--color-shift{% endif %}"
  {%- if color_zones != blank %}
  data-color-zones="{{ color_zones | escape }}"
  {%- endif %}
  {%- if initial_color != blank %}
  data-initial-color="{{ initial_color }}"
  {%- endif %}
>
  <div class="site-header__inner">
    <a href="{{ routes.root_url }}" class="site-header__wordmark">
      <img
        src="{{ 'poyse-logo-white.svg' | asset_url }}"
        alt="{{ section.settings.wordmark_text | escape }}"
        class="site-header__wordmark-logo site-header__wordmark-logo--white"
        width="663"
        height="175"
      >
      <img
        src="{{ 'poyse-logo-black.svg' | asset_url }}"
        alt=""
        aria-hidden="true"
        class="site-header__wordmark-logo site-header__wordmark-logo--black"
        width="663"
        height="175"
      >
    </a>

    {%- render '_nav-links', nav_links: nav_links, cart_count: cart_count -%}
  </div>
</site-header>

{% schema %}
{
  "name": "t:sections.custom-site-header.name",
  "settings": [
    {
      "type": "text",
      "id": "wordmark_text",
      "default": "POYSE",
      "label": "t:sections.custom-site-header.settings.wordmark_text.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "t:sections.custom-site-header.blocks.nav_link.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "t:sections.custom-site-header.blocks.nav_link.settings.label.default",
          "label": "t:sections.custom-site-header.blocks.nav_link.settings.label.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.custom-site-header.blocks.nav_link.settings.link.label"
        }
      ]
    }
  ]
}
{% endschema %}
